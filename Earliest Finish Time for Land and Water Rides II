class Solution:
    def earliestFinishTime(self, 
                           landStartTime: list[int], landDuration: list[int], 
                           waterStartTime: list[int], waterDuration: list[int]) -> int:
        
        min_land_finish = float('inf')
        for start, dur in zip(landStartTime, landDuration):
            min_land_finish = min(min_land_finish, start + dur)
            
        case1_total_time = float('inf')
        for start, dur in zip(waterStartTime, waterDuration):
            case1_total_time = min(case1_total_time, max(min_land_finish, start) + dur)
            
        min_water_finish = float('inf')
        for start, dur in zip(waterStartTime, waterDuration):
            min_water_finish = min(min_water_finish, start + dur)
            
        case2_total_time = float('inf')
        for start, dur in zip(landStartTime, landDuration):
            case2_total_time = min(case2_total_time, max(min_water_finish, start) + dur)
            
        return min(case1_total_time, case2_total_time)